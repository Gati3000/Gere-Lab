cd /root/Gere-Lab/Web-UI
:root, [data-theme="dark"] {
  --bg:#0d0d0d; --panel:#171717; --panel2:#222; --border:#333;
  --text:#f2f2f2; --muted:#9a9a9a; --btn:#2a2a2a; --btn-hover:#3a3a2a;
  --primary:#f2f2f2; --primary-text:#0d0d0d; --overlay:rgba(0,0,0,.65);
}
[data-theme="light"] {
  --bg:#ececec; --panel:#ffffff; --panel2:#f5f5f5; --border:#cfcfcf;
  --text:#141414; --muted:#6b6b6b; --btn:#e2e2e2; --btn-hover:#d2d2d2;
  --primary:#141414; --primary-text:#ffffff; --overlay:rgba(0,0,0,.4);
}
* { box-sizing:border-box; }
html, body { height:100%; margin:0; }
body { background:var(--bg); color:var(--text); font-family:system-ui,Segoe UI,Roboto,sans-serif; display:flex; flex-direction:column; }
.topbar { display:flex; justify-content:space-between; align-items:flex-start; padding:14px 22px; border-bottom:1px solid var(--border); background:var(--panel); }
.brand { font-size:1.4rem; font-weight:700; letter-spacing:.5px; }
.tools { display:flex; flex-direction:column; align-items:flex-end; gap:8px; }
.tools .row { display:flex; gap:8px; align-items:center; }
.btn, select { background:var(--btn); color:var(--text); border:1px solid var(--border); border-radius:8px; padding:8px 14px; font-size:.95rem; cursor:pointer; text-decoration:none; }
.btn:hover, select:hover { background:var(--btn-hover); }
.btn.primary { background:var(--primary); color:var(--primary-text); border-color:var(--primary); font-weight:600; }
.btn.primary:hover { opacity:.85; }
.btn.ghost { background:transparent; }
.layout { flex:1; min-height:0; display:grid; grid-template-columns:1.4fr 1fr; gap:18px; padding:18px 22px; }
.window { background:var(--panel); border:1px solid var(--border); border-radius:12px; display:flex; flex-direction:column; min-height:0; }
.window > h2 { margin:0; padding:14px 18px; font-size:1.05rem; border-bottom:1px solid var(--border); }
.window .content { flex:1; overflow-y:auto; padding:14px 18px; display:flex; flex-direction:column; gap:10px; }
.msg { background:var(--panel2); border:1px solid var(--border); border-radius:10px; padding:10px 14px; }
.msg .meta { color:var(--muted); font-size:.8rem; margin-bottom:4px; display:flex; justify-content:space-between; }
.card { background:var(--panel2); border:1px solid var(--border); border-radius:10px; padding:14px; }
.card dl { margin:0 0 12px; display:grid; grid-template-columns:auto 1fr; gap:4px 12px; }
.card dt { color:var(--muted); }
.card dd { margin:0; }
.card .actions { display:flex; gap:8px; }
.card .actions .btn { flex:1; }
.card.done { opacity:.55; }
.status { font-weight:600; }
.empty { color:var(--muted); text-align:center; padding:24px; }
.modal-bg { position:fixed; inset:0; background:var(--overlay); display:none; align-items:center; justify-content:center; padding:16px; }
.modal-bg.open { display:flex; }
.modal { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:20px; width:min(480px,100%); }
.modal h3 { margin:0 0 6px; }
.modal p { margin:0 0 12px; color:var(--muted); }
.modal textarea { width:100%; min-height:120px; resize:vertical; background:var(--panel2); color:var(--text); border:1px solid var(--border); border-radius:8px; padding:10px; font:inherit; }
.modal .actions { display:flex; justify-content:flex-end; gap:8px; margin-top:14px; }
@media (max-width:900px) { .layout { grid-template-columns:1fr; } .window { min-height:360px; } }
